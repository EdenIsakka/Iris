# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://finanzas:finanzas@localhost:5433/finanzas
CORS_ORIGIN=http://localhost:8081

# La app móvil tiene su propio archivo: apps/mobile/.env.example

# Better Auth (ADR-0006). Genera el secreto con: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL con la que el teléfono llega a la API (la IP de tu PC en la red local).
BETTER_AUTH_URL=http://localhost:3000
