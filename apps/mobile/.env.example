# Expo solo lee el .env de esta carpeta y solo variables con prefijo EXPO_PUBLIC_.
# En un celular físico, "localhost" es el propio celular: usa la IP de tu PC en la red local
# (Windows: ipconfig, macOS/Linux: ifconfig), por ejemplo http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
