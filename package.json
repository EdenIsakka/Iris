{
  "name": "finanzas-app",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @finanzas/db generate",
    "db:migrate": "pnpm --filter @finanzas/db migrate",
    "db:seed": "pnpm --filter @finanzas/db seed",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "lefthook": "^2.0.0",
    "turbo": "^2.11.10"
  }
}
